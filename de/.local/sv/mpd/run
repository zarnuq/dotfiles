#!/bin/bash
# Group service: mpd + mpd-mpris (MPRIS/D-Bus bridge) as one unit.
# If either exits, the whole group is torn down and runsv restarts both
# together (mpd-mpris is useless without mpd). Replaces the old separate
# mpDris2 service dir.
exec 2>&1

xrd="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
pids=""

cleanup() { kill $pids 2>/dev/null; exit; }
trap cleanup TERM INT

# Explicit config path: mpd otherwise resolves $XDG_CONFIG_HOME/mpd/mpd.conf and
# silently falls back to /etc/mpd.conf, which logs to root-owned /var/log/mpd
# and dies on "Permission denied" if anything leaks a stray XDG_CONFIG_HOME in.
mpd --no-daemon "$HOME/.config/mpd/mpd.conf" & pids="$pids $!"

# bridge needs the dbus session bus and a reachable mpd (localhost:6600)
while [ ! -S "$xrd/bus" ]; do sleep 0.2; done
tries=0
until (exec 3<>/dev/tcp/127.0.0.1/6600) 2>/dev/null; do
	# An mpd that dies at startup used to leave this spinning forever, so runsv
	# kept reporting the service up with no mpd behind it. Bail out loudly.
	tries=$((tries + 1))
	if [ "$tries" -gt 75 ]; then
		echo "mpd never accepted connections on 6600 (see errors above); restarting"
		kill $pids 2>/dev/null
		exit 1
	fi
	sleep 0.2
done
mpd-mpris & pids="$pids $!"

wait -n                    # block until either exits...
kill $pids 2>/dev/null     # ...then take the group down
wait                       # reap, then exit -> runsv respawns both
