+// Opt-in agent control. The existing read-only panel socket is unchanged.
+// SOCK_SEQPACKET keeps request boundaries explicit; no partial-line parser can
+// block the WM. Mutations run only in river's manage phase.
+const std = @import("std");
+const linux = std.os.linux;
+const Context = @import("context.zig");
+const config = @import("config.zig");
+const query = @import("query.zig");
+const Window = @import("window.zig").Window;
+const log = std.log.scoped(.agent);
+
+pub const max_clients = 8;
+pub var listen_fd: ?i32 = null;
+pub var client_fds: [max_clients]i32 = undefined;
+pub var client_count: usize = 0;
+var requests: [max_clients]?Request = .{null} ** max_clients;
+var socket_path: ?[:0]const u8 = null;
+
+const Geometry = struct { id: u64, x: i32, y: i32, width: i32, height: i32 };
+
+const Request = union(enum) {
+    focus: u64,
+    desktop: u32,
+    geometry: Geometry,
+    close: u64,
+};
+
+pub fn start() void {
+    const p = std.c.getenv("REACH_AGENT_SOCKET") orelse return;
+    const path = std.mem.span(p);
+    if (path.len == 0 or path.len >= 108 or path[0] != '/') {
+        log.err("REACH_AGENT_SOCKET must be an absolute Unix socket path", .{});
+        return;
+    }
+    const fd = std.c.socket(linux.AF.UNIX, linux.SOCK.SEQPACKET | linux.SOCK.NONBLOCK | linux.SOCK.CLOEXEC, 0);
+    if (fd < 0) return;
+    var addr = linux.sockaddr.un{ .path = .{0} ** 108 };
+    @memcpy(addr.path[0..path.len], path);
+    // Do not unlink an existing endpoint: that could detach another live WM.
+    if (std.c.bind(fd, @ptrCast(&addr), @sizeOf(linux.sockaddr.un)) < 0 or std.c.listen(fd, max_clients) < 0) {
+        _ = std.c.close(fd);
+        log.err("cannot bind agent socket {s}", .{path});
+        return;
+    }
+    socket_path = path;
+    listen_fd = fd;
+    log.info("agent protocol 1 listening on {s}", .{path});
+}
+
+pub fn stop() void {
+    while (client_count > 0) drop(client_count - 1);
+    if (listen_fd) |fd| _ = std.c.close(fd);
+    listen_fd = null;
+    if (socket_path) |path| _ = std.c.unlink(path.ptr);
+    socket_path = null;
+}
+
+pub fn onAccept() void {
+    const fd = listen_fd orelse return;
+    while (true) {
+        const peer = std.c.accept4(fd, null, null, linux.SOCK.NONBLOCK | linux.SOCK.CLOEXEC);
+        if (peer < 0) return;
+        const Credentials = extern struct { pid: i32, uid: u32, gid: u32 };
+        var credentials: Credentials = undefined;
+        var credentials_len: std.c.socklen_t = @sizeOf(Credentials);
+        const authenticated = std.c.getsockopt(peer, linux.SOL.SOCKET, linux.SO.PEERCRED, &credentials, &credentials_len) == 0 and
+            credentials_len == @sizeOf(Credentials) and credentials.uid == linux.getuid();
+        if (!authenticated or client_count == max_clients) {
+            _ = std.c.close(peer);
+            continue;
+        }
+        client_fds[client_count] = peer;
+        requests[client_count] = null;
+        client_count += 1;
+    }
+}
+
+fn drop(i: usize) void {
+    _ = std.c.close(client_fds[i]);
+    client_count -= 1;
+    if (i != client_count) {
+        client_fds[i] = client_fds[client_count];
+        requests[i] = requests[client_count];
+    }
+    requests[client_count] = null;
+}
+
+fn reply(i: usize, value: anytype) void {
+    const gpa = Context.get().gpa;
+    const data = std.json.Stringify.valueAlloc(gpa, value, .{}) catch return;
+    defer gpa.free(data);
+    _ = std.c.send(client_fds[i], data.ptr, data.len, linux.MSG.NOSIGNAL | linux.MSG.DONTWAIT);
+}
+
+fn fail(i: usize, message: []const u8) void {
+    reply(i, .{ .ok = false, .@"error" = message });
+}
+
+pub fn onClient(i: usize) bool {
+    var buf: [256]u8 = undefined;
+    const n = std.c.recv(client_fds[i], &buf, buf.len, linux.MSG.DONTWAIT | linux.MSG.TRUNC);
+    if (n <= 0) {
+        drop(i);
+        return false;
+    }
+    if (n > buf.len) {
+        fail(i, "request too long");
+        return false;
+    }
+    const text = std.mem.trim(u8, buf[0..@intCast(n)], " \t\r\n");
+    if (std.mem.eql(u8, text, "list")) {
+        snapshot(i);
+        return false;
+    }
+    if (requests[i] != null) {
+        fail(i, "request already pending");
+        return false;
+    }
+    requests[i] = parse(text) catch {
+        fail(i, "invalid command or arguments");
+        return false;
+    };
+    return true;
+}
+
+fn number(comptime T: type, tokens: *std.mem.TokenIterator(u8, .any)) !T {
+    return std.fmt.parseInt(T, tokens.next() orelse return error.MissingArgument, 10);
+}
+
+fn parse(text: []const u8) !Request {
+    var tokens = std.mem.tokenizeAny(u8, text, " \t");
+    const verb = tokens.next() orelse return error.MissingCommand;
+    const request: Request = if (std.mem.eql(u8, verb, "focus"))
+        .{ .focus = try number(u64, &tokens) }
+    else if (std.mem.eql(u8, verb, "close"))
+        .{ .close = try number(u64, &tokens) }
+    else if (std.mem.eql(u8, verb, "desktop")) blk: {
+        const desktop = try number(u32, &tokens);
+        if (!config.validDesktop(desktop)) return error.InvalidDesktop;
+        break :blk .{ .desktop = desktop };
+    } else if (std.mem.eql(u8, verb, "geometry")) blk: {
+        const geometry: Geometry = .{
+            .id = try number(u64, &tokens),
+            .x = try number(i32, &tokens),
+            .y = try number(i32, &tokens),
+            .width = try number(i32, &tokens),
+            .height = try number(i32, &tokens),
+        };
+        if (geometry.width <= 0 or geometry.height <= 0 or geometry.width > 32768 or geometry.height > 32768 or
+            geometry.x < -32768 or geometry.x > 32768 or geometry.y < -32768 or geometry.y > 32768) return error.InvalidGeometry;
+        break :blk .{ .geometry = geometry };
+    } else return error.UnknownCommand;
+    if (tokens.next() != null) return error.ExtraArgument;
+    return request;
+}
+
+fn find(id: u64) ?*Window {
+    for (Context.get().windows.items) |w| if (w.agent_id == id) return w;
+    return null;
+}
+
+// Requests are revalidated here: a window may have closed since it was queued.
+pub fn apply() void {
+    const ctx = Context.get();
+    for (0..client_count) |i| {
+        const request = requests[i] orelse continue;
+        requests[i] = null;
+        switch (request) {
+            .desktop => |d| {
+                const out = ctx.current_output orelse {
+                    fail(i, "no output");
+                    continue;
+                };
+                out.desktop = d;
+                ctx.focused = query.topVisibleOn(out);
+            },
+            .focus => |id| {
+                const w = find(id) orelse {
+                    fail(i, "unknown window");
+                    continue;
+                };
+                if (!w.mapped) {
+                    fail(i, "window is not mapped");
+                    continue;
+                }
+                if (w.output) |out| out.desktop = w.desktop;
+                ctx.focus(w);
+            },
+            .geometry => |g| {
+                const w = find(g.id) orelse {
+                    fail(i, "unknown window");
+                    continue;
+                };
+                if (!w.mapped or w.fullscreen) {
+                    fail(i, "geometry requires a mapped non-fullscreen window");
+                    continue;
+                }
+                w.floating = true;
+                w.rule_floating = true;
+                w.float_placed = true;
+                w.x = g.x;
+                w.y = g.y;
+                w.width = g.width;
+                w.height = g.height;
+            },
+            .close => |id| {
+                const w = find(id) orelse {
+                    fail(i, "unknown window");
+                    continue;
+                };
+                w.rwm.close();
+            },
+        }
+        reply(i, .{ .ok = true });
+    }
+}
+
+const WindowInfo = struct {
+    id: u64,
+    title: []const u8,
+    appId: []const u8,
+    desktop: u32,
+    output: []const u8,
+    focused: bool,
+    mapped: bool,
+    visible: bool,
+    floating: bool,
+    x: i32,
+    y: i32,
+    width: i32,
+    height: i32,
+};
+
+fn snapshot(i: usize) void {
+    const ctx = Context.get();
+    const windows = ctx.gpa.alloc(WindowInfo, ctx.windows.items.len) catch {
+        fail(i, "out of memory");
+        return;
+    };
+    defer ctx.gpa.free(windows);
+    for (ctx.windows.items, windows) |w, *info| {
+        info.* = .{
+            .id = w.agent_id,
+            .title = w.title orelse "",
+            .appId = w.app_id orelse "",
+            .desktop = w.desktop,
+            .output = if (w.output) |o| o.name orelse "" else "",
+            .focused = ctx.focused == w,
+            .mapped = w.mapped,
+            .visible = w.visible(),
+            .floating = w.floating,
+            .x = w.x,
+            .y = w.y,
+            .width = w.drawnWidth(),
+            .height = w.drawnHeight(),
+        };
+    }
+    reply(i, .{ .ok = true, .protocol = 1, .pid = std.os.linux.getpid(), .windows = windows });
+}
+
+test "agent requests reject extra arguments, invalid desktops and geometry" {
+    const r = try parse("focus 42");
+    try std.testing.expectEqual(@as(u64, 42), r.focus);
+    try std.testing.expectError(error.ExtraArgument, parse("focus 42 extra"));
+    try std.testing.expectError(error.InvalidDesktop, parse("desktop 0"));
+    try std.testing.expectError(error.InvalidGeometry, parse("geometry 1 0 0 -1 300"));
+    try std.testing.expectError(error.MissingArgument, parse("geometry 1 0"));
+    const g = try parse("geometry 1 -10 20 800 600");
+    try std.testing.expectEqual(@as(i32, -10), g.geometry.x);
+    try std.testing.expectError(error.UnknownCommand, parse("spawn shell"));
+}
