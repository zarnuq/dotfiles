[Desktop Entry]
Type=Application
Name=Agent desktop
Comment=Isolated desktop for agent GUI tests: start, view, take control, stop
Exec=qs ipc call agentdesk open
Icon=preferences-desktop-remote-desktop
Terminal=false
Categories=Utility;
Keywords=agent;vnc;test;claude;
Actions=view;control;resume;stop;

[Desktop Action view]
Name=View (read-only)
Exec=agent-desk view

[Desktop Action control]
Name=Take control
Exec=agent-desk view --control

[Desktop Action resume]
Name=Give control back to the agent
Exec=agent-desk resume

[Desktop Action stop]
Name=Stop
Exec=agent-desk stop
