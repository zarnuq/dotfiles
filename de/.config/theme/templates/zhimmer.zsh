# Generated by theme-set into ~/.local/state/theme/zhimmer.zsh — edit
# ~/.config/theme/templates/zhimmer.zsh instead. zhimmer sources it at load
# (zstyle ':zhimmer:*' theme-file, set in .zshrc); new shells only.
ZHIMMER_COLORS+=(
  history '{{overlay0}}'  search '{{pink}}'  alias '{{mauve}}'  command '{{blue}}'
  file '{{peach}}'  branch '{{green}}'  remote '{{teal}}'  changed '{{red}}'
  host '{{sky}}'  target '{{yellow}}'  script '{{yellow}}'  zoxide '{{yellow}}'
  files '{{peach}}'  directories '{{peach}}'  options '{{blue}}'  commands '{{blue}}'
  branches '{{green}}'  parameters '{{mauve}}'
)
ZHIMMER_ROW_COLORS+=(
  history '{{green}}'  command '{{green}}'  alias '{{mauve}}'  file '{{peach}}'
  git-branch '{{green}}'  git-remote '{{teal}}'  git-file '{{red}}'  ssh-host '{{sky}}'
  make '{{yellow}}'  npm-script '{{yellow}}'  zoxide '{{yellow}}'
)
ZHIMMER_PROMPT_COLORS+=(
  path '{{blue}}'  branch '{{mauve}}'  status '{{yellow}}'  arrows '{{peach}}'
  ok '{{green}}'  error '{{red}}'
)
ZHIMMER_ROW_PRECOMMAND_COLOR='fg={{green}},underline'
ZHIMMER_RULE_COLOR='{{surface0}}'
ZHIMMER_HEADER_COLOR='{{overlay0}}'
ZHIMMER_SELECT_BG='{{surface1}}'
_zhimmer_select_from_bg
zstyle ':zhimmer:*' ghost-color 'fg={{overlay0}}'
