.{
    // --- layout / behavior -------------------------------------------------
    .outer_gap = 0,
    .inner_gap = 0,
    .sloppy_focus = true,
    .repeat_rate = 50,
    .repeat_delay = 300,
    .nmaster = 1,
    .mfact = 0.6,
    .float_default_frac_w = 0.6,
    .float_default_frac_h = 0.65,
    .float_step = 40,

    .cursor = .{
        .theme = "default",
        .size = 24,
        // A shake no longer grows the cursor — it runs this. reach detects the
        // gesture (raw evdev deltas; it has no cursor position to draw at) and
        // quickshell dims the screen with a clear circle around the pointer.
        // NOTE: `.command` needs a reach that knows the field — an unknown key
        // fails the whole ZON parse and drops reach to compiled-in defaults.
        .shake = .{
            .enabled = true,
            .delay = 150,
            .command = "qs ipc call spotlight flash",
        },
    },

    // --- tmux-style focused-window border ----------------------------------
    .border_active = 0xcba6f7,
    .border_inactive = 0x45475a,
    .border_thickness = 5,

    // --- session environment (dwl setupenv) --------------------------------
    .env = .{
        .{ "XDG_CURRENT_DESKTOP", "river" },
        .{ "XDG_SESSION_TYPE", "wayland" },
        .{ "QT_QPA_PLATFORM", "wayland" },
        .{ "DBUS_SESSION_BUS_ADDRESS", "unix:path=/run/user/1000/bus" },
        // nix bins not always inherited from greetd (laptop vs desktop)
        .{ "PATH", "/home/miles/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/home/miles/.local/bin:/home/miles/.config/emacs/bin:/usr/local/bin:/usr/bin:/bin" },
        .{ "XDG_DATA_DIRS", "/home/miles/.nix-profile/share:/nix/var/nix/profiles/default/share:/usr/local/share:/usr/share" },
        .{ "PROTON_ENABLE_WAYLAND", "1" },
    },

    // --- startup programs (dwl autostart) ----------------------------------
    // Each is run via /bin/sh -c, so $HOME / pipes / & all work.
    .autostart = .{
        "$HOME/.config/reach/autostart.sh",
    },

    // --- monitors (dwl monrules) -------------------------------------------
    // Matched by connector name. Array ORDER defines monitor numbering for
    // focusmon/sendmon and window-rule .monitor indices. transform is one of
    // .normal .rotate_90 .rotate_180 .rotate_270 .flipped .flipped_90/180/270.
    .monitors = .{
        .{ .name = "DP-3", .w = 3440, .h = 1440, .x = 0, .y = 0, .transform = .rotate_180 },
        .{ .name = "DP-2", .w = 3440, .h = 1440, .x = 0, .y = 1440 },
        .{ .name = "DP-1", .w = 1920, .h = 1080, .refresh = 165000, .x = 3440, .y = 1440, .transform = .rotate_270 },
        // Laptop pair. Both need explicit x/y: with x/y left at the (-1,-1)
        // default reach never sends set_position, so river leaves every head at
        // 0,0 and they stack on top of each other. HDMI sits above the laptop
        // panel, which is centred under it (3840/2 - 1920/2 = 960 in from the
        // external's left edge). The whole pair is parked past x=4520 so it
        // stays clear of the desktop's DP block if they are ever live together.
        .{ .name = "HDMI-A-1", .w = 3840, .h = 2160, .refresh = 60000, .x = 5000, .y = 0 },
        .{ .name = "eDP-1", .w = 1920, .h = 1200, .x = 5960, .y = 2160 },
    },

    // --- window rules (dwl rules) ------------------------------------------
    // Match app_id/title: "^foo" = starts-with, "foo" = contains. desktop is a
    // 1-based desktop number (0/absent = leave it where it opened). monitor is an
    // index into .monitors above.
    .rules = .{
        .{ .app_id = "rmpc", .desktop = 1, .monitor = 2 },
        .{ .app_id = "zen", .desktop = 3, .switchto = true },
        .{ .app_id = "^steam", .desktop = 5 },
        .{ .app_id = "signal", .desktop = 4 },
        .{ .app_id = "^float", .floating = true, .x = 0.25, .y = 0.25, .w = 0.5, .h = 0.5 },
        .{ .app_id = "pavucontrol", .floating = true, .x = 0.25, .y = 0.25, .w = 0.5, .h = 0.5 },
    },

    // --- the baked-in status bar -------------------------------------------
    // Off: the bar is quickshell's now (Bar.qml), drawn as a layer surface whose
    // exclusive zone reserves the strip — so reach no longer has to subtract it
    // from the layout by hand. reach still publishes the desktop/focus/title
    // state it used to draw, over the socket in its src/ipc.zig; with the bar
    // off, that socket is the only way any of it leaves the window manager.
    //
    // `enabled` needs a reach new enough to KNOW the field: an unknown key fails
    // the whole parse and reach falls back to its compiled-in defaults — no
    // binds, no monitor layout. Install the binary before this file.
    .bar = .{ .enabled = false },

    // --- keybindings -------------------------------------------------------
    // Providing `binds` REPLACES the entire default action/spawn/chord keymap
    // always generated and are NOT listed here. A bind is either a leaf (`.action`)
    // or a chord leader (`.chord` = list of sub-keys; sub-keys carry no modifier
    // and nest to any depth). Actions: .{ .view = n } / .{ .send = n } (1-based
    // desktop number), .{ .spawn = "cmd" }, .quit, .killclient, .zoom, .togglefloating,
    // .togglefullscreen, .{ .move = .{ .x=,.y= } }, .{ .resize = ... },
    // .{ .focusstack = n }, .{ .setmfact = f }, .{ .incnmaster = n },
    // .{ .focusmon = n }, .{ .sendmon = n }, .reload.
    .binds = .{
        // launchers
        .{ .key = "Super+p", .action = .{ .spawn = "qs ipc call lock lock" } },
        .{ .key = "Super+Tab", .action = .{ .spawn = "kitty" } },
        .{ .key = "Super+d", .action = .{ .spawn = "GDK_BACKEND=wayland emacs" } },
        .{ .key = "Super+space", .action = .{ .spawn = "qs ipc call launcher toggle" } },
        .{ .key = "Super+Shift+Escape", .action = .{ .spawn = "qs ipc call settings toggle" } },
        .{ .key = "Super+BackSpace", .action = .{ .spawn = "kitty --class float" } },
        .{ .key = "Super+v", .action = .{ .spawn = "kitty --class float -e $HOME/.local/bin/clipfzf" } },
        .{ .key = "Super+x", .action = .{ .spawn = "kitty --class float -e $HOME/.local/bin/killfzf" } },
        .{ .key = "Super+z", .action = .{ .spawn = "kitty --class float -e $HOME/.local/bin/svfzf" } },
        .{ .key = "Super+Shift+z", .action = .{ .spawn = "kitty --class float -e $HOME/.local/bin/ssvfzf" } },
        .{ .key = "Super+w", .action = .{ .spawn = "kitty --class rmpc rmpc" } },
        .{ .key = "Super+Shift+w", .action = .{ .spawn = "rmpc rescan" } },
        .{ .key = "Super+t", .action = .{ .spawn = "zen-browser" } },
        .{ .key = "Super+b", .action = .{ .spawn = "qs ipc call wallpaper random" } },
        .{ .key = "Super+Shift+b", .action = .{ .spawn = "qs ipc call wallpaperpicker toggle" } },

        .{ .key = "Super+r", .chord = .{
            .{ .key = "d", .action = .{ .spawn = "legcord" } },
            .{ .key = "b", .action = .{ .spawn = "brave" } },
            .{ .key = "a", .action = .{ .spawn = "qs ipc call audio toggle" } },
            .{ .key = "s", .action = .{ .spawn = "exec steam </dev/null >/dev/null 2>&1" } },
        } },

        .{ .key = "Super+s", .chord = .{
            .{ .key = "s", .action = .{ .spawn = "$HOME/.local/bin/screenshot.sh ss && notify-send Screenshot 'Quick capture saved!'" } },
            .{ .key = "d", .action = .{ .spawn = "$HOME/.local/bin/screenshot.sh section && notify-send Screenshot 'Section saved!'" } },
            .{ .key = "0", .action = .{ .spawn = "$HOME/.local/bin/screenshot.sh eDP-1 && notify-send Screenshot 'Fullscreen saved!'" } },
            .{ .key = "1", .action = .{ .spawn = "$HOME/.local/bin/screenshot.sh DP-1 && notify-send Screenshot 'Fullscreen saved!'" } },
            .{ .key = "2", .action = .{ .spawn = "$HOME/.local/bin/screenshot.sh DP-2 && notify-send Screenshot 'Fullscreen saved!'" } },
            .{ .key = "3", .action = .{ .spawn = "$HOME/.local/bin/screenshot.sh DP-3 && notify-send Screenshot 'Fullscreen saved!'" } },
        } },

        // media / volume / mic
        .{ .key = "XF86AudioPlay", .action = .{ .spawn = "qs ipc call media playpause" } },
        .{ .key = "XF86AudioPrev", .action = .{ .spawn = "qs ipc call media previous" } },
        .{ .key = "XF86AudioNext", .action = .{ .spawn = "qs ipc call media next" } },
        .{ .key = "Alt+Up", .action = .{ .spawn = "pactl set-sink-volume @DEFAULT_SINK@ +5%" } },
        .{ .key = "Alt+Down", .action = .{ .spawn = "pactl set-sink-volume @DEFAULT_SINK@ -5%" } },
        .{ .key = "Alt+Left", .action = .{ .spawn = "pactl set-source-volume @DEFAULT_SOURCE@ -5%" } },
        .{ .key = "Alt+Right", .action = .{ .spawn = "pactl set-source-volume @DEFAULT_SOURCE@ +5%" } },
        .{ .key = "Alt+End", .action = .{ .spawn = "pactl set-source-mute @DEFAULT_SOURCE@ toggle" } },
        .{ .key = "Alt+bracketleft", .action = .{ .spawn = "$HOME/.local/bin/flip.sh" } },

        // brightness / redshift
        .{ .key = "Super+Alt+Left", .action = .{ .spawn = "$HOME/.local/bin/brightness.sh down" } },
        .{ .key = "Super+Alt+Right", .action = .{ .spawn = "$HOME/.local/bin/brightness.sh up" } },
        .{ .key = "Super+Alt+Up", .action = .{ .spawn = "$HOME/.local/bin/redshift.sh" } },

        // window management
        .{ .key = "Super+Shift+r", .action = .reload },
        .{ .key = "Super+Shift+p", .action = .quit },
        .{ .key = "Super+Shift+q", .action = .killclient },
        .{ .key = "Super+Return", .action = .zoom },
        .{ .key = "Super+f", .action = .togglefloating },
        .{ .key = "Super+Shift+f", .action = .togglefullscreen },

        // floating move (Super+arrows) / resize (Super+Shift+arrows), step = 40
        .{ .key = "Super+Left", .action = .{ .move = .{ .x = -40 } } },
        .{ .key = "Super+Right", .action = .{ .move = .{ .x = 40 } } },
        .{ .key = "Super+Up", .action = .{ .move = .{ .y = -40 } } },
        .{ .key = "Super+Down", .action = .{ .move = .{ .y = 40 } } },
        .{ .key = "Super+Shift+Left", .action = .{ .resize = .{ .x = -40 } } },
        .{ .key = "Super+Shift+Right", .action = .{ .resize = .{ .x = 40 } } },
        .{ .key = "Super+Shift+Up", .action = .{ .resize = .{ .y = -40 } } },
        .{ .key = "Super+Shift+Down", .action = .{ .resize = .{ .y = 40 } } },

        // focus / layout
        .{ .key = "Super+j", .action = .{ .focusstack = 1 } },
        .{ .key = "Super+k", .action = .{ .focusstack = -1 } },
        .{ .key = "Super+h", .action = .{ .setmfact = -0.05 } },
        .{ .key = "Super+l", .action = .{ .setmfact = 0.05 } },
        .{ .key = "Super+m", .action = .{ .incnmaster = -1 } },
        .{ .key = "Super+n", .action = .{ .incnmaster = 1 } },
        .{ .key = "Super+comma", .action = .{ .focusmon = -1 } },
        .{ .key = "Super+period", .action = .{ .focusmon = 1 } },
        .{ .key = "Super+Shift+comma", .action = .{ .sendmon = -1 } },
        .{ .key = "Super+Shift+period", .action = .{ .sendmon = 1 } },
    },
}
