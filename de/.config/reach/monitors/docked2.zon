// monitors/docked2.zon — one reach display layout, written by the display configurator.
//
// Selected by the `monitors.zon` symlink in the parent directory; reach opens
// that path and applies whatever `.monitors` it finds. This header is preserved
// across saves; anything else added by hand below it is not.
.{
    .monitors = .{
        .{ .name = "eDP-1", .w = 1920, .h = 1200, .x = 0, .y = 1080 },
        .{ .name = "DP-4", .w = 1920, .h = 1080, .x = 1920, .y = 360, .transform = .rotate_270 },
        .{ .name = "DP-7", .w = 1920, .h = 1080, .x = 0, .y = 0 },
        .{ .name = "DP-1", .w = 1920, .h = 1200, .x = 3000, .y = 0, .transform = .rotate_90 },
    },
}
