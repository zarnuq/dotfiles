// monitors/desktop.zon — one reach display layout.
//
// Selected by the `monitors.zon` SYMLINK in the parent directory:
//
//     ln -sfn monitors/desktop.zon ~/.config/reach/monitors.zon
//     kill -HUP $(pidof reach)          # or Super+Shift+r
//
// reach knows nothing about presets: it opens monitors.zon, the kernel follows
// the link, and whatever this file lists IS the monitor table. The link is
// gitignored, so each machine keeps its own choice; the layouts themselves are
// committed.
//
// Written by the display configurator (`Super+R` `m`), which regenerates the
// file from its parsed contents — this header survives, anything else written
// by hand below it does not.
//
// Array ORDER is monitor numbering: it decides focusmon/tagmon direction and the
// `.monitor` index that window rules in config.zon use. A head that isn't
// connected is simply ignored. A rotated head's .w/.h are its MODE; the transform
// swaps them in the layout.
.{
    .monitors = .{
        // Two ultrawides stacked, portrait 165 Hz head right of the lower one.
        // DP-3 is mounted upside down, hence rotate_180.
        .{ .name = "DP-3", .w = 3440, .h = 1440, .x = 0, .y = 0, .transform = .rotate_180 },
        .{ .name = "DP-2", .w = 3440, .h = 1440, .x = 0, .y = 1440 },
        .{ .name = "DP-1", .w = 1920, .h = 1080, .refresh = 165000, .x = 3440, .y = 1440, .transform = .rotate_270 },
    },
}
